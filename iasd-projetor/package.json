{
  "name": "iasd-projetor",
  "version": "0.1.0",
  "private": true,
  "description": "Companheiro Windows para projeção IASD APP",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never"
  },
  "dependencies": {},
  "devDependencies": {
    "electron-builder": "^26.0.0",
    "electron": "^35.0.0"
  },
  "build": {
    "appId": "br.iasd.projetor",
    "productName": "IASD Projetor",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/iasd-app.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "IASD Projetor"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "victoorlyma5555",
        "repo": "Iasd-studio"
      }
    ],
    "copyright": "Copyright © 2026 Victor Lima · IASD APP"
  },
  "author": "Victor Lima",
  "repository": {
    "type": "git",
    "url": "https://github.com/victoorlyma5555/Iasd-studio.git"
  }
}
